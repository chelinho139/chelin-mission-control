def mascot_name(session_id: str) -> str:
    """Deterministic mascot name from a session_id — same name every render
    for the same session, no state file needed."""
    if not session_id or session_id == "(no transcript)":
        return ""
    h = int(hashlib.md5(session_id.encode()).hexdigest(), 16)
    return MASCOT_NAMES[h % len(MASCOT_NAMES)]


def _draw_card(stdscr, s: Session, y: int, x: int, is_cursor: bool):
    inner_w = CARD_W - 2
    # cursor highlight wins over status color; otherwise the border itself
    # carries the status color so e.g. a red STUCK card jumps out across the
    # grid. blink on a border is visual chaos — strip it.
    if is_cursor:
        border_attr = curses.color_pair(C_CURSOR) | curses.A_BOLD
    else:
        border_attr = status_color(s.status) & ~curses.A_BLINK

    safe_addstr(stdscr, y, x, "+" + "-" * (CARD_W - 2) + "+", border_attr)
    safe_addstr(stdscr, y + CARD_H - 1, x, "+" + "-" * (CARD_W - 2) + "+", border_attr)
    for i in range(1, CARD_H - 1):
        safe_addstr(stdscr, y + i, x, "|", border_attr)
        safe_addstr(stdscr, y + i, x + CARD_W - 1, "|", border_attr)

    # title overlaid on top border: "[ ◆ project[:branch] ]"
    title_room = inner_w - 4  # for "[ " and " ]"
    branch_part = f":{s.branch}" if s.branch and s.branch not in ("—", "?") else ""
    title_inner = f" {s.status.glyph} {s.project_name}{branch_part} "[:title_room]
    title_attr = (curses.color_pair(C_CURSOR) | curses.A_BOLD) if is_cursor \
                 else (curses.color_pair(C_TITLE) | curses.A_BOLD)
    safe_addstr(stdscr, y, x + 2, f"[{title_inner}]", title_attr)

    # content layout (CARD_H=11 → 9 content lines):
    #   rows 1-4  mascot (centered; row 1 carries the floating Z for sleeping)
    #   row 5     status verb   ← centered under mascot face (the headline)
    #   row 6     empty         ← breathing room beneath the verb
    #   row 7     status detail ← centered, dim
    #   row 8     tokens · % of context (centered, dim)
    #   row 9     last user prompt, prefixed "> " (dim, truncated with …)
    frame = _mascot_frame(s.status)
    # mascot tinted with status color, but no bold/blink — keep it ambient
    mascot_attr = status_color(s.status) & ~curses.A_BLINK & ~curses.A_BOLD
    mascot_x = x + 1 + (inner_w - MASCOT_W) // 2
    for i, line in enumerate(frame):
        safe_addstr(stdscr, y + 1 + i, mascot_x, line, mascot_attr)

    # mascot name, left-aligned on row 1 (overlays the mascot's blank header
    # row). capped at 12 chars so it never crashes into the sleeping Z, which
    # floats far right at inner col 16.
    name = mascot_name(s.session_id)
    if name:
        safe_addstr(stdscr, y + 1, x + 1, name[:12], curses.color_pair(C_DIM))

    # center status under the mascot's face (the 7-col body), not the full
    # 13-col mascot+accessory block. otherwise the verb appears pulled right
    # of the eyes because the accessory padding shifts the block's midpoint.
    MASCOT_FACE_W = 7
    face_center = (inner_w - MASCOT_W) // 2 + MASCOT_FACE_W // 2
    verb = s.status.value.upper()
    detail = s.status_detail
    safe_addstr(stdscr, y + 5, x + 1, _centered_at(verb, face_center, inner_w),
                status_color(s.status))
    safe_addstr(stdscr, y + 7, x + 1, _centered_at(detail, face_center, inner_w),
                curses.color_pair(C_DIM))

    ctx_window = 1_000_000 if "1m" in (s.model or "").lower() else CONTEXT_WINDOW_DEFAULT
    ctx_pct = int(round(s.last_context_tokens / ctx_window * 100)) \
              if s.last_context_tokens else 0
    line_meta = f"{fmt_tokens(s.tokens_total)} tok · {ctx_pct}% ctx"[:inner_w]

    last_cmd = (s.last_user_msg or "").strip().replace("\n", " ")
    prefix = "> "
    budget = inner_w - len(prefix)
    if not last_cmd:
        line_cmd = f"{prefix}(no input yet)"
    elif len(last_cmd) > budget:
        line_cmd = f"{prefix}{last_cmd[:budget - 1]}…"
    else:
        line_cmd = f"{prefix}{last_cmd}"
    line_cmd = line_cmd[:inner_w]

    safe_addstr(stdscr, y + 8, x + 1, _centered_at(line_meta, face_center, inner_w),
                curses.color_pair(C_DIM))
    safe_addstr(stdscr, y + 9, x + 1, line_cmd.ljust(inner_w),
                curses.color_pair(C_DIM))


def render_grid(stdscr, sessions: list[Session], cursor: int, top: int, grid_h: int):
    h, w = stdscr.getmaxyx()
    draw_box(stdscr, top, 0, grid_h, w, "live sessions")

    if not sessions:
        safe_addstr(stdscr, top + 2, 4,
                    "no live claude sessions found in the last 30 minutes",
                    curses.color_pair(C_DIM))
        return

    avail_h = grid_h - 2
    cols = grid_cols(w)
    rows = max(1, (avail_h + CARD_GAP) // (CARD_H + CARD_GAP))
    page_size = cols * rows
    page_start = (cursor // page_size) * page_size

    for i, s in enumerate(sessions[page_start:page_start + page_size]):
        idx = page_start + i
        c, r = i % cols, i // cols
        cy = top + 1 + r * (CARD_H + CARD_GAP)
        cx = 2 + c * (CARD_W + CARD_GAP)
        if cx + CARD_W > w - 1 or cy + CARD_H > top + grid_h - 1:
            break
        _draw_card(stdscr, s, cy, cx, idx == cursor)

    # paging hint when there's overflow
    total_pages = (len(sessions) + page_size - 1) // page_size
    if total_pages > 1:
        page_num = (cursor // page_size) + 1
        hint = f" page {page_num}/{total_pages} — {len(sessions)} sessions "
        safe_addstr(stdscr, top + grid_h - 1, max(2, w - len(hint) - 2),
                    hint, curses.color_pair(C_DIM))


def render_detail(stdscr, sessions: list[Session], cursor: int, detail_y: int, detail_h: int):
    if detail_h <= 4 or not sessions:
        return
    _, w = stdscr.getmaxyx()
    s = sessions[cursor] if cursor < len(sessions) else sessions[0]
    draw_box(stdscr, detail_y, 0, detail_h, w,
             f"detail :: {s.session_id[:8]}")
    # branch/idle/model/pid all collapse into one row to save space — the
    # detail pane is height-limited and dropping them off the bottom would
    # be a worse outcome than fitting them on one line.
    meta = (f"branch: {s.branch}  ·  idle: {fmt_idle(s.idle_sec)}"
            f"  ·  model: {s.model}  ·  pid: {s.pid or '—'}")
    info_lines = [
        ("cwd",        s.cwd),
        ("session",    s.session_id),
        ("meta",       meta),
        ("last user",  s.last_user_msg.replace("\n", " ⏎ ")),
        ("last asst",  s.last_assistant_msg.replace("\n", " ⏎ ")),
        ("last tool",  s.last_tool or "—"),
        ("cache read", fmt_tokens(s.cache_read)),
    ]
    for i, (k, v) in enumerate(info_lines):
        if i >= detail_h - 2:
            break
        safe_addstr(stdscr, detail_y + 1 + i, 2,
                    f"{k:>10} :", curses.color_pair(C_HEADER))
        safe_addstr(stdscr, detail_y + 1 + i, 14, str(v))


def render_keybar(stdscr, message: str, mode: str = "cards"):
    h, w = stdscr.getmaxyx()
    move = "[h/j/k/l]" if mode == "cards" else "[j/k]"
    keys = f" {move}move [f]ocus [enter]detail [o]pen [c]opy [K]ill [r]efresh [q]uit "
    safe_addstr(stdscr, h - 1, 0, keys.ljust(w - 1)[: w - 1],
                curses.color_pair(C_BORDER) | curses.A_REVERSE)
    if message:
        safe_addstr(stdscr, h - 1, w - len(message) - 2, message,
                    curses.color_pair(C_HEADER) | curses.A_BOLD)


def render(stdscr, sessions: list[Session], cursor: int, last_refresh: float,
           message: str, mode: str = "cards"):
    stdscr.erase()
    h, _ = stdscr.getmaxyx()
    top = 3
    # reserve 10 rows below the table/grid for the detail pane + keybar (was
    # 8). bumped because the detail pane gained more fields and was clipping
    # `last user` / `last asst` on typical 40-row terminals.
    table_h = max(8, h - top - 10)
    render_header(stdscr, sessions, last_refresh)
    if mode == "cards":
        render_grid(stdscr, sessions, cursor, top, table_h)
    else:
        render_table(stdscr, sessions, cursor, top, table_h)
    render_detail(stdscr, sessions, cursor, top + table_h, h - (top + table_h) - 2)
    render_keybar(stdscr, message, mode)
    stdscr.refresh()


def show_detail_modal(stdscr, s: Session):
    h, w = stdscr.getmaxyx()
    win = curses.newwin(h - 4, w - 6, 2, 3)
    win.keypad(True)
    win.erase()
    draw_box(win, 0, 0, h - 4, w - 6, f"transcript tail :: {s.project_name}")
    y = 1
    for e in s.tail_entries:
        if y >= h - 6:
            break
        t = e.get("type", "?")
        msg = e.get("message") or {}
        content = msg.get("content") if isinstance(msg, dict) else None
        prefix = {"user": "U>", "assistant": "A>", "system": "S>"}.get(t, "??")
        attr = {"user": curses.color_pair(C_WAITING),
                "assistant": curses.color_pair(C_WORKING),
                "system": curses.color_pair(C_DIM)}.get(t, 0)
        text = ""
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            chunks = []
            for c in content:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "text":
                    chunks.append(c.get("text", ""))
                elif c.get("type") == "tool_use":
                    chunks.append(f"<tool_use {c.get('name')}>")
                elif c.get("type") == "tool_result":
                    chunks.append("<tool_result>")
            text = " | ".join(chunks)
        text = text.replace("\n", " ⏎ ")[: w - 14]
        safe_addstr(win, y, 2, prefix, attr | curses.A_BOLD)
        safe_addstr(win, y, 5, text)
        y += 1
    safe_addstr(win, h - 6, 2, "press any key to return",
                curses.color_pair(C_DIM))
    win.refresh()
    win.getch()


def copy_to_clipboard(text: str) -> bool:
    try:
        p = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
        p.communicate(text.encode())
        return p.returncode == 0
    except Exception:
        return False


def open_in_finder(path: str):
    try:
        subprocess.Popen(["open", path])
    except Exception:
        pass


def tty_for_pid(pid: int) -> Optional[str]:
    try:
        r = subprocess.run(["ps", "-o", "tty=", "-p", str(pid)],
                           capture_output=True, text=True, timeout=1)
        t = r.stdout.strip()
        if t and t != "?":
            return f"/dev/{t}" if not t.startswith("/dev/") else t
    except Exception:
        pass
    return None


_ITERM_SCRIPT = '''
on run argv
  set ttyPath to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if tty of s is ttyPath then
            select s
            tell t to select
            tell w to select
            activate
            return "ok"
          end if
        end repeat
      end repeat
    end repeat
    return "not found"
  end tell
end run
'''

_TERMINAL_SCRIPT = '''
on run argv
  set ttyPath to item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if tty of t is ttyPath then
          set selected of t to true
          set index of w to 1
          activate
          return "ok"
        end if
      end repeat
    end repeat
    return "not found"
  end tell
end run
'''


def _run_osascript(script: str, arg: str) -> tuple[bool, str]:
    try:
        r = subprocess.run(
            ["osascript", "-", arg],
            input=script, capture_output=True, text=True, timeout=3,
        )
        if "ok" in r.stdout:
            return True, ""
        return False, (r.stderr or "").strip()
    except Exception as e:
        return False, str(e)


def focus_terminal_for_tty(tty_path: str) -> tuple[bool, str]:
    """Activate the iTerm2 (or Terminal.app) window+tab whose TTY matches.

    Returns (ok, message).
    """
    ok, _ = _run_osascript(_ITERM_SCRIPT, tty_path)
    if ok:
        return True, "focused iTerm2"
    ok, err = _run_osascript(_TERMINAL_SCRIPT, tty_path)
    if ok:
        return True, "focused Terminal"
    return False, err or "tab not found"


def main(stdscr, mode: str = "cards"):
    curses.curs_set(0)
    init_colors()
    stdscr.nodelay(True)
    stdscr.timeout(200)
    gc_state_files()

    sessions: list[Session] = []
    cursor = 0
    last_refresh = 0.0
    message = ""
    message_until = 0.0

    def refresh():
        nonlocal sessions, last_refresh, cursor
        sessions = discover_sessions()
        last_refresh = time.time()
        if cursor >= len(sessions):
            cursor = max(0, len(sessions) - 1)

    refresh()

    while True:
        if time.time() - last_refresh >= REFRESH_SEC:
            refresh()
        if message and time.time() > message_until:
            message = ""
        render(stdscr, sessions, cursor, last_refresh, message, mode)

        try:
            ch = stdscr.getch()
        except KeyboardInterrupt:
            break
        if ch == -1:
            continue
        if ch in (ord("q"), 27):
            break
        elif ch in (ord("j"), curses.KEY_DOWN):
            if sessions:
                if mode == "cards":
                    cols = grid_cols(stdscr.getmaxyx()[1])
                    nxt = cursor + cols
                    cursor = nxt if nxt < len(sessions) else cursor
                else:
                    cursor = (cursor + 1) % len(sessions)
        elif ch in (ord("k"), curses.KEY_UP):
            if sessions:
                if mode == "cards":
                    cols = grid_cols(stdscr.getmaxyx()[1])
                    prv = cursor - cols
                    cursor = prv if prv >= 0 else cursor
                else:
                    cursor = (cursor - 1) % len(sessions)
        elif ch in (ord("h"), curses.KEY_LEFT):
            if sessions and mode == "cards":
                cursor = (cursor - 1) % len(sessions)
        elif ch in (ord("l"), curses.KEY_RIGHT):
            if sessions and mode == "cards":
                cursor = (cursor + 1) % len(sessions)
        elif ch == ord("g"):
            cursor = 0
        elif ch == ord("G"):
            cursor = max(0, len(sessions) - 1)
        elif ch == ord("r"):
            refresh()
            message = "refreshed"
            message_until = time.time() + 1.5
        elif ch in (curses.KEY_ENTER, 10, 13):
            if sessions:
                show_detail_modal(stdscr, sessions[cursor])
        elif ch == ord("o"):
            if sessions:
                open_in_finder(sessions[cursor].cwd)
                message = "opened"
                message_until = time.time() + 1.5
        elif ch == ord("c"):
            if sessions:
                ok = copy_to_clipboard(sessions[cursor].session_id)
                message = "copied" if ok else "copy failed"
                message_until = time.time() + 1.5
        elif ch == ord("K"):
            if sessions and sessions[cursor].pid:
                try:
                    os.kill(sessions[cursor].pid, 15)  # SIGTERM
                    message = f"sent SIGTERM to {sessions[cursor].pid}"
                except Exception as e:
                    message = f"kill failed: {e}"
                message_until = time.time() + 2.0
        elif ch == ord("f"):
            if sessions:
                s = sessions[cursor]
                if not s.pid:
                    message = "no live pid"
                else:
                    tty = tty_for_pid(s.pid)
                    if not tty:
                        message = "no tty for pid"
                    else:
                        ok, msg = focus_terminal_for_tty(tty)
                        message = msg
                message_until = time.time() + 2.0


def _build_arg_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="chelin-mission-control",
        description="Mission Control for live Claude Code sessions.",
    )
    g = p.add_mutually_exclusive_group()
    g.add_argument("--setup", action="store_true",
                   help="install hook entries in ~/.claude/settings.json so the TUI "
                        "can detect session state authoritatively")
    g.add_argument("--teardown", action="store_true",
                   help="remove the hook entries previously installed by --setup")
    g.add_argument("--hook", action="store_true",
                   help="(internal) hook callback — reads JSON payload from stdin "
                        "and appends to ~/.claude/mission-control/<session>.state.jsonl")
    p.add_argument("--rows", action="store_true",
                   help="use the classic single-row-per-session table layout "
                        "instead of the default card grid")
    return p


if __name__ == "__main__":
    args = _build_arg_parser().parse_args()
    if args.hook:
        sys.exit(cmd_hook())
    if args.setup:
        sys.exit(cmd_setup())
    if args.teardown:
        sys.exit(cmd_teardown())
    maybe_prompt_first_run()
    try:
        curses.wrapper(main, "rows" if args.rows else "cards")
    except KeyboardInterrupt:
        pass

#!/usr/bin/env python3
"""chelin-mission-control — Mission Control for live Claude Code sessions.

Renders a NetHack-style TUI listing every active Claude Code session on this
machine: project, branch, status, idle time, model, tokens. Polls the
~/.claude/projects/ JSONL transcripts plus the live `claude` process list.

Keys:
  j/k or arrows  move cursor
  g / G          jump to top / bottom
  enter          show session detail (last messages)
  f              focus the iTerm/Terminal tab running this session
  o              open the cwd in Finder
  c              copy session id to clipboard
  K              send SIGTERM to the session's process
  r              force refresh
  q / esc        quit
"""
from __future__ import annotations

import argparse
import curses
import hashlib
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass, field
from enum import Enum
from pathlib import Path
from typing import Optional

PROJECTS_DIR = Path.home() / ".claude" / "projects"
SETTINGS_PATH = Path.home() / ".claude" / "settings.json"
MC_DIR       = Path.home() / ".claude" / "mission-control"
NO_PROMPT_SENTINEL = MC_DIR / ".no-setup-prompt"
LIVE_WINDOW_SEC = 30 * 60  # transcripts touched within this window count as "live"
REFRESH_SEC = 2.0

# events we install hooks for — every signal we need for accurate status detection
HOOK_EVENTS = (
    "SessionStart", "SessionEnd",
    "UserPromptSubmit",
    "PreToolUse", "PostToolUse",
    "PermissionRequest",
    "Notification",
    "Stop", "StopFailure",
    "SubagentStart", "SubagentStop",
)
# sentinel string embedded in installed hook commands so we can identify our
# entries during --setup / --teardown regardless of script path or rename
HOOK_MARKER = "CMC_HOOK=1"


class Status(str, Enum):
    WORKING = "working"
    WAITING = "waiting"
    IDLE    = "idle"
    STUCK   = "stuck"
    ENDED   = "ended"
    ZOMBIE  = "zombie"

    @property
    def glyph(self) -> str:
        return _STATUS_GLYPH[self]


_STATUS_GLYPH = {
    Status.WORKING: "◆",
    Status.WAITING: "!",
    Status.IDLE:    "·",
    Status.STUCK:   "✗",
    Status.ENDED:   "†",
    Status.ZOMBIE:  "Z",
}


# ──────────────────────────────────────────────────────────────────────────────
# Data model
# ──────────────────────────────────────────────────────────────────────────────

@dataclass
class Session:
    session_id: str
    jsonl_path: Path
    cwd: str
    project_name: str = ""
    branch: str = "?"
    status: Status = Status.IDLE
    status_detail: str = ""
    last_activity: float = 0.0
    # transcript / process creation time, used as a stable sort key so rows
    # don't reorder across refreshes (mtime would, since it ticks on every
    # transcript write).
    created_at: float = 0.0
    model: str = "?"
    tokens_in: int = 0
    tokens_out: int = 0
    cache_read: int = 0
    # most recent assistant turn's prompt size (input + cache_read) — i.e. the
    # current conversation context size, used to render "% of context"
    last_context_tokens: int = 0
    pid: Optional[int] = None
    last_user_msg: str = ""
    last_assistant_msg: str = ""
    last_tool: str = ""
    tail_entries: list[dict] = field(default_factory=list)

    @property
    def idle_sec(self) -> float:
        return time.time() - self.last_activity

    @property
    def tokens_total(self) -> int:
        return self.tokens_in + self.tokens_out


# ──────────────────────────────────────────────────────────────────────────────
# Hook callback + state file
# ──────────────────────────────────────────────────────────────────────────────
#
# When `chelin-mission-control --setup` runs, it installs hook commands in
# `~/.claude/settings.json` that re-invoke this script as `<path> --hook`.
# Claude Code fires those hooks during sessions and pipes a JSON payload on
# stdin. The hook handler appends a compact event record to a per-session
# state file at `~/.claude/mission-control/<session_id>.state.jsonl`.
# `summarize_session` reads that state file as the authoritative source of
# truth for status — no JSONL transcript heuristics involved.

def cmd_hook() -> int:
    """Hook callback mode — read JSON payload from stdin, append to state file."""
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0  # never block Claude on parse failure
    sid = payload.get("session_id")
    if not sid:
        return 0
    rec = {
        "ts": time.time(),
        "event": payload.get("hook_event_name") or "?",
    }
    # carry only the fields we use for status / display
    for k in ("tool_name", "tool_use_id", "matcher", "permission_mode", "reason"):
        v = payload.get(k)
        if v is not None:
            rec[k] = v
    try:
        MC_DIR.mkdir(parents=True, exist_ok=True)
        with (MC_DIR / f"{sid}.state.jsonl").open("a") as f:
            f.write(json.dumps(rec, separators=(",", ":")) + "\n")
    except Exception:
        pass  # never block Claude
    return 0


def gc_state_files(max_age_sec: float = 24 * 3600) -> None:
    """Delete state files untouched for longer than `max_age_sec`."""
    if not MC_DIR.exists():
        return
    cutoff = time.time() - max_age_sec
    for p in MC_DIR.glob("*.state.jsonl"):
        try:
            if p.stat().st_mtime < cutoff:
                p.unlink()
        except OSError:
            pass


def read_state_events(session_id: str) -> list[dict]:
    """Return the list of hook events recorded for this session, in order."""
    p = MC_DIR / f"{session_id}.state.jsonl"
    if not p.exists():
        return []
    try:
        return [json.loads(ln) for ln in p.read_text().splitlines() if ln.strip()]
    except Exception:
        return []


def status_from_events(events: list[dict]) -> tuple[Optional[Status], str, str]:
    """Derive (status, detail, last_tool) from a session's hook event log.

    Returns (None, "", "") if the events don't tell us anything actionable
    (caller should then fall back to JSONL heuristics).
    """
    if not events:
        return None, "", ""
    # tool_use_id → (tool_name, PreToolUse ts) — track ts so we can later
    # discard orphan entries (PreToolUse with no matching PostToolUse from
    # tools that crashed or were interrupted long ago).
    pending_tools: dict[str, tuple[str, float]] = {}
    pending_permission_tool: Optional[str] = None
    # `stopped` tracks whether the assistant explicitly handed control back.
    # Set on Stop / StopFailure; cleared on UserPromptSubmit / PreToolUse
    # (the user re-engaged or the assistant is using a tool again). This
    # lets us still report WAITING for a session whose last event is some
    # tail noise (e.g. an info-only Notification) but whose most recent
    # state-changing event was Stop.
    stopped: Optional[tuple[Status, str]] = None
    last_tool = ""
    for e in events:
        ev = e.get("event")
        tu = e.get("tool_use_id")
        name = e.get("tool_name")
        ts = e.get("ts") or 0.0
        if name:
            last_tool = name
        if ev == "PreToolUse" and tu:
            pending_tools[tu] = (name or "?", ts)
            stopped = None
        elif ev in ("PostToolUse", "PostToolUseFailure") and tu:
            pending_tools.pop(tu, None)
            # answering a permission prompt clears it
            pending_permission_tool = None
        elif ev == "PermissionRequest":
            pending_permission_tool = name or last_tool or "?"
        elif ev == "Notification" and e.get("matcher") == "permission_prompt":
            pending_permission_tool = name or last_tool or "?"
        elif ev == "UserPromptSubmit":
            stopped = None
        elif ev == "Stop":
            pending_permission_tool = None
            stopped = (Status.WAITING, "needs input")
        elif ev == "StopFailure":
            reason = e.get("matcher") or e.get("reason") or "?"
            stopped = (Status.STUCK, str(reason))
        elif ev == "SessionEnd":
            return Status.ENDED, "", last_tool

    last = events[-1]
    last_ev = last.get("event")
    last_ts = last.get("ts") or 0
    # The "in-flight" signals (pending_tools, pending_permission_tool, last
    # event ∈ {UserPromptSubmit, PostToolUse, SubagentStart/Stop, …}) are only
    # meaningful while the session is actually firing hooks. Healthy sessions
    # fire something every few seconds during real work; quiescent state is
    # >60s with nothing new. After that:
    #   - pending_tools entries are orphans (PreToolUse with no PostToolUse
    #     match — tools that crashed, were interrupted, or whose follow-up
    #     hooks never fired). They aren't actually running.
    #   - The last in-flight event is stale; the assistant has moved on
    #     without firing Stop (typical for sessions whose hooks were
    #     installed mid-life and partially registered).
    # Either way, return None so summarize_session falls back to the JSONL
    # heuristic, which can read `stop_reason` authoritatively.
    # Stop / StopFailure / SessionStart remain authoritative regardless of
    # age — they're terminal signals about what state the session ended in.
    STALE_INFLIGHT_SEC = 60
    quiescent = bool(last_ts and time.time() - last_ts > STALE_INFLIGHT_SEC)
    # Drop orphan PreToolUses (no PostToolUse match within the freshness
    # window). These accumulate over a session's lifetime when tools crash
    # or are interrupted; without this filter, a single ancient Bash that
    # never returned would mark the session WORKING forever.
    now = time.time()
    fresh_pending = [name for (name, ts) in pending_tools.values()
                     if ts and now - ts < STALE_INFLIGHT_SEC]
    if pending_permission_tool and not quiescent:
        return Status.STUCK, f"awaiting permission ({pending_permission_tool})", last_tool
    if fresh_pending and not quiescent:
        return Status.WORKING, f"tool: {fresh_pending[0]}", last_tool
    if stopped is not None:
        return stopped[0], stopped[1], last_tool
    if quiescent:
        return None, "", last_tool
    if last_ev == "UserPromptSubmit":
        return Status.WORKING, "thinking", last_tool
    if last_ev in ("PostToolUse", "PostToolUseFailure", "SubagentStart", "SubagentStop"):
        # tool just finished; next PreToolUse or Stop is on the way
        return Status.WORKING, "thinking", last_tool
    if last_ev == "SessionStart":
        return Status.IDLE, "", last_tool
    return None, "", last_tool


# ──────────────────────────────────────────────────────────────────────────────
# Setup / teardown — manage hook entries in ~/.claude/settings.json
# ──────────────────────────────────────────────────────────────────────────────

def _read_settings() -> dict:
    if not SETTINGS_PATH.exists():
        return {}
    try:
        return json.loads(SETTINGS_PATH.read_text())
    except Exception as e:
        print(f"error reading {SETTINGS_PATH}: {e}", file=sys.stderr)
        sys.exit(1)


def _write_settings(data: dict) -> None:
    SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
    SETTINGS_PATH.write_text(json.dumps(data, indent=2) + "\n")


def _hook_command() -> str:
    # the leading `CMC_HOOK=1` is both a harmless env var and our sentinel
    # for matching this entry on later --setup / --teardown runs
    return f"{HOOK_MARKER} {Path(__file__).resolve()} --hook"


def _is_our_group(group: dict) -> bool:
    """True if a hook group contains a command referencing this tool."""
    for h in group.get("hooks", []) or []:
        if isinstance(h, dict) and HOOK_MARKER in str(h.get("command", "")):
            return True
    return False


def cmd_setup() -> int:
    settings = _read_settings()
    hooks = settings.setdefault("hooks", {})
    new_group = {
        "matcher": "",
        "hooks": [{"type": "command", "command": _hook_command()}],
    }
    added, already = [], []
    for event in HOOK_EVENTS:
        groups = hooks.setdefault(event, [])
        if any(_is_our_group(g) for g in groups):
            already.append(event)
            continue
        groups.append(new_group)
        added.append(event)
    _write_settings(settings)
    MC_DIR.mkdir(parents=True, exist_ok=True)
    try:
        MC_DIR.chmod(0o700)
    except OSError:
        pass
    print(f"settings: {SETTINGS_PATH}")
    print(f"state dir: {MC_DIR}")
    print(f"installed: {', '.join(added) if added else '(none — all already present)'}")
    if already:
        print(f"already present: {', '.join(already)}")
    return 0


def cmd_teardown() -> int:
    settings = _read_settings()
    hooks = settings.get("hooks", {})
    removed = []
    for event in list(hooks.keys()):
        before = len(hooks[event])
        hooks[event] = [g for g in hooks[event] if not _is_our_group(g)]
        if len(hooks[event]) != before:
            removed.append(event)
        if not hooks[event]:
            del hooks[event]
    if not hooks:
        settings.pop("hooks", None)
    _write_settings(settings)
    print(f"removed from: {', '.join(removed) if removed else '(no entries found)'}")
    return 0


def hooks_installed() -> bool:
    """True if any of our hook entries are present in ~/.claude/settings.json."""
    if not SETTINGS_PATH.exists():
        return False
    try:
        settings = json.loads(SETTINGS_PATH.read_text())
    except Exception:
        return False
    hooks = settings.get("hooks", {})
    for event in HOOK_EVENTS:
        for group in hooks.get(event, []) or []:
            if _is_our_group(group):
                return True
    return False


def maybe_prompt_first_run() -> None:
    """If hooks aren't installed and the user hasn't opted out, ask once.

    Defaults to installing on Enter. Writes a sentinel file when the user
    picks "don't ask again" so we never prompt on this machine again.
    Skipped in non-interactive contexts (piped stdin, etc).
    """
    if hooks_installed() or NO_PROMPT_SENTINEL.exists():
        return
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return
    print("chelin-mission-control can install hooks in ~/.claude/settings.json")
    print("for accurate status detection (especially permission prompts).")
    print("without them, the TUI falls back to JSONL transcript heuristics.")
    print()
    print("  [Y] install now (recommended)")
    print("  [n] skip — use heuristic mode for this run")
    print("  [d] skip and don't ask again")
    print()
    try:
        choice = input("> ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        sys.exit(0)
    if choice in ("", "y", "yes"):
        cmd_setup()
        print()
        try:
            input("press enter to launch mission control...")
        except (EOFError, KeyboardInterrupt):
            sys.exit(0)
    elif choice in ("d", "dont", "don't"):
        try:
            MC_DIR.mkdir(parents=True, exist_ok=True)
            NO_PROMPT_SENTINEL.touch()
        except OSError:
            pass


# ──────────────────────────────────────────────────────────────────────────────
# Discovery
# ──────────────────────────────────────────────────────────────────────────────

def decode_project_dir(name: str) -> str:
    """Best-effort decode of the encoded cwd in the projects dir name.

    Claude Code encodes the cwd by replacing `/` with `-`, so the original
    path can't be perfectly recovered (real `-` chars are ambiguous). We try
    the path-as-is, then probe the filesystem for the longest matching dir.
    """
    if not name.startswith("-"):
        return name
    parts = name[1:].split("-")
    # Greedy: try to assemble the longest existing path by joining segments.
    candidate = Path("/")
    i = 0
    while i < len(parts):
        # try the longest remaining join first
        for j in range(len(parts), i, -1):
            chunk = "-".join(parts[i:j])
            trial = candidate / chunk
            if trial.exists():
                candidate = trial
                i = j
                break
        else:
            # nothing matched → just append remaining as dashed
            candidate = candidate / "-".join(parts[i:])
            break
    return str(candidate)


def live_claude_pids() -> dict[str, int]:
    """Return mapping of cwd → pid for currently-running `claude` processes."""
    out = {}
    try:
        ps = subprocess.run(
            ["ps", "-axo", "pid,command"], capture_output=True, text=True, timeout=2
        ).stdout
    except Exception:
        return out
    for line in ps.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        # match the command's basename — avoids false positives from any
        # process whose argv happens to mention "claude" (e.g. this script,
        # editors, grep, osascript invocations).
        argv0 = parts[1].split(None, 1)[0]
        if Path(argv0).name != "claude":
            continue
        # walk the cwd via lsof if we can
        try:
            cwd = subprocess.run(
                ["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                capture_output=True, text=True, timeout=1
            ).stdout
            for ln in cwd.splitlines():
                if ln.startswith("n"):
                    out[ln[1:]] = pid
        except Exception:
            pass
    return out


def git_info(cwd: str) -> tuple[str, str]:
    """Return (project_name, branch) for a given cwd.

    project_name is the name of the *main* repo, even when cwd is a git
    worktree. We get there via `--git-common-dir`, which points back to the
    canonical .git directory of the host repo regardless of the worktree's
    on-disk location (so it works for any worktree layout, not just the
    .claude/worktrees/<name> shape we use here). branch is whatever HEAD points
    at right now in this worktree. Falls back to the cwd basename and "—" when
    git is unavailable or cwd isn't inside a repo.
    """
    fallback_name = Path(cwd).name or cwd
    try:
        r1 = subprocess.run(
            ["git", "-C", cwd, "rev-parse",
             "--show-toplevel", "--git-common-dir"],
            capture_output=True, text=True, timeout=1
        )
        if r1.returncode != 0:
            return fallback_name, "—"
        lines = r1.stdout.strip().splitlines()
        if len(lines) < 2:
            return fallback_name, "—"
        common = Path(lines[1])
        if not common.is_absolute():
            # in the main repo, --git-common-dir prints `.git` relative to cwd
            common = (Path(cwd) / common).resolve()
        # parent of `.git` is the host repo root; this is the worktree fix —
        # `--show-toplevel` would give us the worktree dir, not the main repo.
        project_root = common.parent if common.name == ".git" else common
        project_name = project_root.name or fallback_name

        r2 = subprocess.run(
            ["git", "-C", cwd, "branch", "--show-current"],
            capture_output=True, text=True, timeout=1
        )
        branch = (r2.stdout.strip() if r2.returncode == 0 else "") or "(detached)"
        return project_name, branch
    except Exception:
        return fallback_name, "—"


def _parse_iso(ts: Optional[str]) -> float:
    """Parse a JSONL entry timestamp ('2026-04-28T15:54:17.031Z') to epoch.
    Returns 0.0 if missing or unparseable."""
    if not ts:
        return 0.0
    try:
        from datetime import datetime
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except Exception:
        return 0.0


def parse_jsonl_tail(path: Path, n: int = 60) -> list[dict]:
    """Read the last N JSONL entries (best-effort, simple full read)."""
    try:
        size = path.stat().st_size
        # only read last ~256KB for big files
        with path.open("rb") as f:
            if size > 256 * 1024:
                f.seek(-256 * 1024, os.SEEK_END)
                f.readline()  # discard partial
            data = f.read().decode("utf-8", errors="replace")
    except Exception:
        return []
    entries = []
    for ln in data.splitlines()[-n:]:
        ln = ln.strip()
        if not ln:
            continue
        try:
            entries.append(json.loads(ln))
        except json.JSONDecodeError:
            continue
    return entries


def summarize_session(path: Path, project_dir_name: str, live_pids: dict[str, int],
                      force_live: bool = False) -> Optional[Session]:
    try:
        st = path.stat()
    except FileNotFoundError:
        return None
    if not force_live and time.time() - st.st_mtime > LIVE_WINDOW_SEC:
        return None
    entries = parse_jsonl_tail(path)
    if not entries:
        return None

    cwd = ""
    model = "?"
    tokens_in = tokens_out = cache_read = 0
    last_context_tokens = 0
    last_user = last_asst = last_tool = ""
    pending_tool_uses: dict[str, str] = {}  # id → name
    # last assistant entry's stop_reason is our authoritative signal when the
    # state file isn't trustworthy. "end_turn" = assistant explicitly handed
    # control back, so the session is at the prompt — that's IDLE, regardless
    # of what mtime might suggest.
    last_asst_stop_reason: Optional[str] = None
    last_asst_ts: float = 0.0

    for e in entries:
        if "cwd" in e and not cwd:
            cwd = e.get("cwd") or ""
        msg = e.get("message") or {}
        if isinstance(msg, dict):
            usage = msg.get("usage") or {}
            tokens_in += usage.get("input_tokens", 0) or 0
            tokens_out += usage.get("output_tokens", 0) or 0
            cache_read += usage.get("cache_read_input_tokens", 0) or 0
            if msg.get("model"):
                model = msg["model"]
            # current context = input + cache_read of most recent assistant turn
            if e.get("type") == "assistant" and usage:
                last_context_tokens = (usage.get("input_tokens", 0) or 0) \
                    + (usage.get("cache_read_input_tokens", 0) or 0)
            if e.get("type") == "assistant" and "stop_reason" in msg:
                last_asst_stop_reason = msg.get("stop_reason")
                last_asst_ts = _parse_iso(e.get("timestamp")) or last_asst_ts
        # extract content
        content = msg.get("content") if isinstance(msg, dict) else None
        if isinstance(content, str):
            if e.get("type") == "user":
                last_user = content[:200]
            elif e.get("type") == "assistant":
                last_asst = content[:200]
        elif isinstance(content, list):
            for c in content:
                if not isinstance(c, dict):
                    continue
                if c.get("type") == "text" and c.get("text"):
                    if e.get("type") == "assistant":
                        last_asst = c["text"][:200]
                    elif e.get("type") == "user":
                        last_user = c["text"][:200]
                elif c.get("type") == "tool_use":
                    pending_tool_uses[c.get("id", "")] = c.get("name", "?")
                    last_tool = c.get("name", "?")
                elif c.get("type") == "tool_result":
                    pending_tool_uses.pop(c.get("tool_use_id", ""), None)

    if not cwd:
        cwd = decode_project_dir(project_dir_name)

    # status: prefer the per-session hook event log (authoritative) and fall
    # back to JSONL-tail heuristics when there's no state file (sessions that
    # started before `--setup` or before chelin-mission-control was installed)
    age = time.time() - st.st_mtime
    pid = live_pids.get(cwd)

    state_events = read_state_events(path.stem)
    state_status, state_detail, state_tool = status_from_events(state_events)
    if state_tool:
        last_tool = state_tool

    # partial-hooks fix: a session that was already running when --setup ran
    # may fire some hooks (UserPromptSubmit, PostToolUse, SubagentStop…) but
    # never Stop. status_from_events would then return WORKING off the most
    # recent in-flight event, hiding the fact that the assistant has *already*
    # written `stop_reason="end_turn"` to the JSONL since. Whichever signal is
    # newer wins; the JSONL is authoritative when it is.
    last_state_ts = state_events[-1].get("ts", 0.0) if state_events else 0.0
    if (state_status == Status.WORKING
            and last_asst_stop_reason == "end_turn"
            and last_asst_ts > last_state_ts
            and not pending_tool_uses):
        state_status, state_detail = None, ""

    if state_status is not None and (force_live or pid is not None):
        status, detail = state_status, state_detail
    elif not (force_live or pid is not None):
        status, detail = Status.ENDED, ""
    elif state_status is not None:  # state file says ENDED even without live pid
        status, detail = state_status, state_detail
    else:
        # fallback: live session, but no state file (or all events stale).
        # Claude Code reads settings.json once at session start, so any
        # session that was already running before --setup will never fire our
        # hooks for its lifetime — there's no reload mechanism (verified via
        # claude-code#5513 / #15858). The JSONL transcript is enough: each
        # assistant entry carries `message.stop_reason` ("end_turn",
        # "tool_use", "max_tokens"), which tells us authoritatively what
        # state the session is in without needing hooks.
        if pending_tool_uses and age > 15:
            status, detail = Status.STUCK, f"awaiting permission ({last_tool})"
        elif pending_tool_uses:
            status, detail = Status.WORKING, f"tool: {last_tool}"
        elif last_asst_stop_reason == "end_turn":
            # assistant explicitly finished its turn — at prompt, no hooks
            status, detail = Status.IDLE, "no hooks"
        elif last_asst_stop_reason == "max_tokens":
            status, detail = Status.STUCK, "max tokens"
        elif last_asst_stop_reason in ("tool_use", None) and age < 2:
            # transcript is currently being written: streaming or just-emitted
            status, detail = Status.WORKING, "thinking"
        else:
            status, detail = Status.IDLE, "no hooks"

    project_name, branch = git_info(cwd)
    return Session(
        session_id=path.stem,
        jsonl_path=path,
        cwd=cwd,
        project_name=project_name,
        branch=branch,
        status=status,
        status_detail=detail,
        last_activity=st.st_mtime,
        created_at=getattr(st, "st_birthtime", st.st_ctime),
        model=model,
        tokens_in=tokens_in,
        tokens_out=tokens_out,
        cache_read=cache_read,
        last_context_tokens=last_context_tokens,
        pid=pid,
        last_user_msg=last_user,
        last_assistant_msg=last_asst,
        last_tool=last_tool,
        tail_entries=entries[-20:],
    )


def encode_cwd(cwd: str) -> str:
    """Inverse of decode_project_dir — replace `/` with `-`."""
    return cwd.replace("/", "-")


def newest_jsonl(proj_dir: Path) -> Optional[Path]:
    candidates = list(proj_dir.glob("*.jsonl"))
    if not candidates:
        return None
    return max(candidates, key=lambda p: p.stat().st_mtime)


def discover_sessions() -> list[Session]:
    if not PROJECTS_DIR.exists():
        return []
    pids = live_claude_pids()  # cwd -> pid

    sessions: list[Session] = []
    seen_jsonl: set[Path] = set()

    # 1) live processes are the source of truth — always include them, no mtime gate
    for cwd, pid in pids.items():
        proj_dir = PROJECTS_DIR / encode_cwd(cwd)
        jl = newest_jsonl(proj_dir) if proj_dir.exists() else None
        if jl:
            s = summarize_session(jl, proj_dir.name, pids, force_live=True)
            if s:
                s.pid = pid
                # zombie heuristic: no transcript activity in the last hour
                if s.idle_sec > 3600:
                    s.status = Status.ZOMBIE
                    s.status_detail = f"no writes for {fmt_idle(s.idle_sec)}"
                sessions.append(s)
                seen_jsonl.add(jl)
                continue
        # no transcript at all — bare process row, use process start time as "last activity"
        try:
            etime = subprocess.run(
                ["ps", "-o", "lstart=", "-p", str(pid)],
                capture_output=True, text=True, timeout=1).stdout.strip()
            started = time.mktime(time.strptime(etime, "%a %b %d %H:%M:%S %Y"))
        except Exception:
            started = time.time()
        proj_name, branch = git_info(cwd)
        sessions.append(Session(
            session_id="(no transcript)",
            jsonl_path=Path("/dev/null"),
            cwd=cwd,
            project_name=proj_name,
            branch=branch,
            status=Status.ZOMBIE,
            status_detail="no transcript file",
            last_activity=started,
            created_at=started,
            pid=pid,
        ))

    # 2) recent transcripts whose process has exited — surface as "ended" so user knows
    for proj in PROJECTS_DIR.iterdir():
        if not proj.is_dir():
            continue
        for jl in proj.glob("*.jsonl"):
            if jl in seen_jsonl:
                continue
            s = summarize_session(jl, proj.name, pids)
            if s:
                sessions.append(s)

    # stable, creation-time sort: oldest at top, newest at bottom. Each row
    # keeps its slot across refreshes regardless of status churn or which
    # session ticked the transcript most recently.
    sessions.sort(key=lambda s: s.created_at)
    return sessions


